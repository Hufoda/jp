# Copy to .env for local development. On Render, set these in the dashboard.

# Required in production
SECRET_KEY=generate-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# PostgreSQL (Render provides DATABASE_URL automatically when linked)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Production security (set on Render)
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# SECURE_SSL_REDIRECT=True

# AWS S3 for videos, audio, PDFs, and images (required for many uploads on Render)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
