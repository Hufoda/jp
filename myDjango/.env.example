# Copy to .env for local development. On Render, set these in the dashboard.

# Required in production
SECRET_KEY=generate-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# PostgreSQL (Render provides DATABASE_URL automatically when linked)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Production security (set on Render)
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# SECURE_SSL_REDIRECT=True

# AWS S3 — optional; only needed if USE_S3=True (see README)
USE_S3=False
